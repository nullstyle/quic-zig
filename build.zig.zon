.{
    .name = .quic,
    .version = "0.22.0",
    .fingerprint = 0xc0795252bd98740e,
    .minimum_zig_version = "0.17.0-dev.1683+5ceec001b",
    .dependencies = .{
        .boringssl = .{
            .url = "https://github.com/nullstyle/boringssl-zig/archive/ff30fe9953b07f838d7ac09ace84dacfb1e896ca.tar.gz",
            .hash = "boringssl-0.6.7-Vv5DN8RMAgDGST3F3NpoMjez8Z_J60megIom9Ru9XqD2",
        },
    },
    // Consumer-facing archive only. The dev trees (bench/,
    // interop/, tests/, tools/) never build downstream — build.zig
    // returns early for dependency builds — so shipping them was pure
    // fetch weight. docs/ DOES ship: EMBEDDING.md and the README link
    // into it, and offline consumers lose the absolute-Git-URL targets
    // otherwise.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "docs",
        "examples",
        "src",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "EMBEDDING.md",
        "LICENSE",
        "README.md",
    },
}
