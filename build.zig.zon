    .paths = .{
        "build.zig",
        "build.zig.zon",
        "examples",
        "src",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "EMBEDDING.md",
        "LICENSE",
        "README.md",
    },
}
